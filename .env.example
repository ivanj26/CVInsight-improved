# Required API credentials
TOKENROUTER_API_KEY=your_tokenrouter_api_key_here
TOKENROUTER_API_URL=https://api.tokenrouter.com/v1
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com
X_API_KEY=

# OpenCode server configuration
OPENCODE_URL=http://localhost:4096
OPENCODE_ENABLED=true
OPENCODE_PROVIDER_ID=your_opencode_provider_id
OPENCODE_MODEL_ID=your_opencode_model_id

# Google Drive downloader only (not used for LLM calls)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here

# Optional configurations
DEFAULT_LLM_MODEL=kimi-k3-free
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=2
RESUME_DIR=./Resumes
OUTPUT_DIR=./Results
LOG_LEVEL=INFO
LOG_FILE=cvinsight.log
TOKEN_LOG_RETENTION_DAYS=7
LOG_MAX_SIZE_MB=5
LOG_BACKUP_COUNT=3
DEBUG=false

# Docs Checker Worker
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_here
DOCS_CHECKER_INPUT_CHANNEL=docs_checker:jobs
DOCS_CHECKER_OUTPUT_CHANNEL=docs_checker:results
DOCS_CHECKER_DEFAULT_LLM_MODEL=agentrouter/gpt-5.6-sol
MAX_CONCURRENT_JOBS=3
